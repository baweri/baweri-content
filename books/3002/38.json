{
  "n": 38,
  "title": "Hakikat Işıkları",
  "blocks": [
    {
      "type": "quote",
      "text": "Herkes bilmez gökte ne var,"
    },
    {
      "type": "quote",
      "text": "Görür onu göz sâhibi"
    },
    {
      "type": "quote",
      "text": "Parıldıyor güneş kadar;"
    },
    {
      "type": "quote",
      "text": "Hakikati ummân gibi."
    },
    {
      "type": "quote",
      "text": "İster gönül elbet huzur,"
    },
    {
      "type": "quote",
      "text": "Âhir demde etmiş zuhûr,"
    },
    {
      "type": "quote",
      "text": "Âlemlere doğmuş o nur;"
    },
    {
      "type": "quote",
      "text": "Gökten inen fermân gibi."
    },
    {
      "type": "quote",
      "text": "Ferdiyeti elhak ayân,"
    },
    {
      "type": "quote",
      "text": "Odur gönüllere sultan,"
    },
    {
      "type": "quote",
      "text": "Var mı bilmem ulu bürhân;"
    },
    {
      "type": "quote",
      "text": "Bu Bediüzzaman gibi."
    },
    {
      "type": "quote",
      "text": "Lisânından saçılır nur,"
    },
    {
      "type": "quote",
      "text": "Cinnî okur, insan okur,"
    },
    {
      "type": "quote",
      "text": "Hûr-u Cennet işte bu “Nur”;"
    },
    {
      "type": "quote",
      "text": "Gönüllerde cânân gibi."
    },
    {
      "type": "quote",
      "text": "Âhirzaman esrârını,"
    },
    {
      "type": "quote",
      "text": "İhbar-ı gayb envârını,"
    },
    {
      "type": "quote",
      "text": "Attı âlem ekdârını;"
    },
    {
      "type": "quote",
      "text": "Doğdu şems-i tâbân gibi."
    },
    {
      "type": "quote",
      "text": "Semâvâttan rahmet indi,"
    },
    {
      "type": "quote",
      "text": "Akan göz yaşları dindi,"
    },
    {
      "type": "quote",
      "text": "Küfr ü dalâl yıldı, sindi;"
    },
    {
      "type": "quote",
      "text": "Görünmeyen şeytan gibi."
    },
    {
      "type": "quote",
      "text": "Söndü hâin fa'âliyet,"
    },
    {
      "type": "quote",
      "text": "Yıkıldı o deccâliyet,"
    },
    {
      "type": "quote",
      "text": "Halâs buldu İslâmiyet;"
    },
    {
      "type": "quote",
      "text": "Tahta çıkan hâkan gibi."
    },
    {
      "type": "quote",
      "text": "Ey yâreli şîr-i jiyan,"
    },
    {
      "type": "quote",
      "text": "Bu hâb-ı gafletten uyan,"
    },
    {
      "type": "quote",
      "text": "Âlemlere devr-i umran;"
    },
    {
      "type": "quote",
      "text": "Asr-ı nüzûl-i Furkàn gibi."
    },
    {
      "type": "quote",
      "text": "İklimlerde îmân yeli"
    },
    {
      "type": "quote",
      "text": "Eser, gönüller neş'eli;"
    },
    {
      "type": "quote",
      "text": "Öpsem, o gül kokan eli,"
    },
    {
      "type": "quote",
      "text": "O bülbül-ü handân gibi."
    },
    {
      "type": "quote",
      "text": "Âdemoğlu necât arar,"
    },
    {
      "type": "quote",
      "text": "Hak dâveti Nurlarda var,"
    },
    {
      "type": "quote",
      "text": "Ey şehriyâr-ı şehriyâr!."
    },
    {
      "type": "quote",
      "text": "Sensin bize sultan gibi."
    },
    {
      "type": "quote",
      "text": "Arşa çıkan feryâdımız,"
    },
    {
      "type": "quote",
      "text": "Alındı şimdi dâdımız;"
    },
    {
      "type": "quote",
      "text": "O sevgili Üstadımız,"
    },
    {
      "type": "quote",
      "text": "Gönülde Süleyman gibi."
    },
    {
      "type": "quote",
      "text": "Ey ekmel-i âhirzaman,"
    },
    {
      "type": "quote",
      "text": "Sensin mahbûb-u Müsteân,"
    },
    {
      "type": "quote",
      "text": "Fedâ sana bu cism ü can;"
    },
    {
      "type": "quote",
      "text": "Hak yolunda kurban gibi."
    },
    {
      "type": "quote",
      "text": "Said’i beklerdi yıllar,"
    },
    {
      "type": "quote",
      "text": "Sensin gönülde muntazar,"
    },
    {
      "type": "quote",
      "text": "Peygamberim vermiş haber;"
    },
    {
      "type": "quote",
      "text": "Olma bize pinhân gibi."
    },
    {
      "type": "quote",
      "text": "Perdelenmişse zuhûrun,"
    },
    {
      "type": "quote",
      "text": "Gizlenmez haşmetli nurun,"
    },
    {
      "type": "quote",
      "text": "Gölgesi olmaz ki nurun;"
    },
    {
      "type": "quote",
      "text": "Firdevs’teki cânân gibi."
    },
    {
      "type": "quote",
      "text": "Ey hatîb-i devr-i zaman!"
    },
    {
      "type": "quote",
      "text": "Sürûr buldu kevn ü mekân;"
    },
    {
      "type": "quote",
      "text": "Seni bekler gizli ayân,"
    },
    {
      "type": "quote",
      "text": "Hep hastalar Lokman gibi."
    },
    {
      "type": "quote",
      "text": "Nur yolunun kurbanıyız,"
    },
    {
      "type": "quote",
      "text": "Kehkeşânın sâmânıyız,"
    },
    {
      "type": "quote",
      "text": "O ateşin dumanıyız;"
    },
    {
      "type": "quote",
      "text": "Ateş yanan külhan gibi."
    },
    {
      "type": "quote",
      "text": "Ra'nâ rengin güle benzer,"
    },
    {
      "type": "quote",
      "text": "Ravh üfürür, kokun eser,"
    },
    {
      "type": "quote",
      "text": "Ufkumuzda oldun seher;"
    },
    {
      "type": "quote",
      "text": "Tam ağaran bir tan gibi."
    },
    {
      "type": "quote",
      "text": "Ey cilvesi zâhir rahmet,"
    },
    {
      "type": "quote",
      "text": "Bâri bizlere imdâd et,"
    },
    {
      "type": "quote",
      "text": "Kulun olmak diler elbet;"
    },
    {
      "type": "quote",
      "text": "Bahçenizde fidan gibi."
    },
    {
      "type": "quote",
      "text": "Pes gönlümüz hep dâim pes,"
    },
    {
      "type": "quote",
      "text": "Ey ağlayan, feryâdı kes!"
    },
    {
      "type": "quote",
      "text": "Boş geçmesin hiçbir nefes,"
    },
    {
      "type": "quote",
      "text": "“ALLAH bes, gayrı heves.”"
    },
    {
      "type": "paragraph",
      "parts": [
        {
          "text": "Mehmed Kayalar",
          "bold": true
        }
      ]
    }
  ]
}
