{
  "n": 39,
  "title": "Gönüller Fâtihi Büyük Üstada",
  "blocks": [
    {
      "type": "paragraph",
      "parts": [
        {
          "text": "Medine-i Münevvere’de bulunan mühim bir âlimin, Risale-i Nur hakkında yazdığı bir manzûmesidir.",
          "italic": true
        }
      ]
    },
    {
      "type": "quote",
      "text": "Nuruyla bütün gönlümü fetheyleyen Üstad!"
    },
    {
      "type": "quote",
      "text": "Gönlüm seni kudsî heyecanlarla eder yâd."
    },
    {
      "type": "quote",
      "text": "İlhâmıma can geldi berâet haberinle,"
    },
    {
      "type": "quote",
      "text": "Mü'minleri şâd eyleyen ulvî zaferinle."
    },
    {
      "type": "quote",
      "text": "Sıyrıldı ufuklardan o kasvetli bulutlar;"
    },
    {
      "type": "quote",
      "text": "Göklerde melekler, bu büyük bayramı kutlar."
    },
    {
      "type": "quote",
      "text": "Milyonların îmânını kurtardı cihadın,"
    },
    {
      "type": "quote",
      "text": "Par par yanar îmânlı gönüllerdeki yâdın."
    },
    {
      "type": "quote",
      "text": "Coşturmada îmânları, binlerle vecîzen,"
    },
    {
      "type": "quote",
      "text": "Tarihini, kudsî heyecanlarla süzerken."
    },
    {
      "type": "quote",
      "text": "İlhâmımı mestetti tecellâ-yı cemâlin;"
    },
    {
      "type": "quote",
      "text": "Fâtih gibi rehberleri andırmada hâlin."
    },
    {
      "type": "quote",
      "text": "Dağlar gibi, sarsılmadın en korkulu günlerde;"
    },
    {
      "type": "quote",
      "text": "Her ânı ölümler dolu tazyîkin önünde."
    },
    {
      "type": "quote",
      "text": "Dünyalara dehşet salıyor sendeki îmân,"
    },
    {
      "type": "quote",
      "text": "Sarsılmayan îmânına düşman bile hayran."
    },
    {
      "type": "quote",
      "text": "Rehber sana, zîra, “Yüce Peygamberimiz”dir;"
    },
    {
      "type": "quote",
      "text": "Ölmez eserin, gençliğe gösterdiğin izdir."
    },
    {
      "type": "quote",
      "text": "Kur'ân-ı Kerîm’in ezelî feyzine erdin;"
    },
    {
      "type": "quote",
      "text": "İnsanlığa îmân ve kemâl dersini verdin."
    },
    {
      "type": "quote",
      "text": "Ey başlara Cennetlerin ufkundan inen tâc!"
    },
    {
      "type": "quote",
      "text": "Âlem senin irfanına, irşadına muhtaç."
    },
    {
      "type": "quote",
      "text": "Deryâ gibi nurlar taşıyor her eserinden;"
    },
    {
      "type": "quote",
      "text": "Allah’a giden Nurcuların rehberisin sen!"
    },
    {
      "type": "quote",
      "text": "Milyonları deryâ gibi coşturmada “Sözler”;"
    },
    {
      "type": "quote",
      "text": "Cennet’teki âlemleri seyretmede gözler."
    },
    {
      "type": "quote",
      "text": "Hikmet dolu her cümlede, Kur'ân’daki Nur var;"
    },
    {
      "type": "quote",
      "text": "Her Lem'ada binbir güneşin huzmesi çağlar."
    },
    {
      "type": "quote",
      "text": "Nur yolcusu, insanlığa örnek olacaktır;"
    },
    {
      "type": "quote",
      "text": "Kudsî heyecanlarla gönüller dolacaktır."
    },
    {
      "type": "quote",
      "text": "Mefkûresi günden güne erdikçe kemâle,"
    },
    {
      "type": "quote",
      "text": "Gark olmada iç âlemi en tatlı visâle."
    },
    {
      "type": "quote",
      "text": "Coştukça denizler gibi kalbindeki îmân;"
    },
    {
      "type": "quote",
      "text": "Bin ders-i hakikat veriyor rûhuna Kur'ân."
    },
    {
      "type": "quote",
      "text": "Âzâdedir, İslâmı saran tehlikelerden;"
    },
    {
      "type": "quote",
      "text": "Da'vâsı temiz çünkü siyâsî lekelerden."
    },
    {
      "type": "quote",
      "text": "Her hamlesinin kuvve-i kudsiyesi vardır;"
    },
    {
      "type": "quote",
      "text": "Vicdânları mesteyleyen ulvî sesi vardır."
    },
    {
      "type": "quote",
      "text": "Aşkın ezelî sırrına erdikçe gönüller,"
    },
    {
      "type": "quote",
      "text": "Yer yer donatır ufkunu sevdâ dolu renkler."
    },
    {
      "type": "quote",
      "text": "Bir ülkeyi baştan başa fetheyledin ey Nur!"
    },
    {
      "type": "quote",
      "text": "Nurun olacaktır bütün insanlığa düstur."
    },
    {
      "type": "quote",
      "text": "Kur'ân seni te'yid ediyor mu'cizelerle;"
    },
    {
      "type": "quote",
      "text": "Ey şânlı gönül fâtihi hiç durmadan ilerle."
    },
    {
      "type": "quote",
      "text": "Tarih-i hayatın doludur hàrikalarla;"
    },
    {
      "type": "quote",
      "text": "Hiç sönmeden âlemde, güneşler gibi parla."
    },
    {
      "type": "quote",
      "text": "Manzûme-i şemsiyeyi temsîl ediyorsun;"
    },
    {
      "type": "quote",
      "text": "Heybetli fezâlarda, hız almış gidiyorsun."
    },
    {
      "type": "quote",
      "text": "Îmânlı nesiller seni takib edecektir;"
    },
    {
      "type": "quote",
      "text": "Yıllarca, asırlarca peşinden gidecektir."
    },
    {
      "type": "quote",
      "text": "Tarihi aşarken, sen, o îmân dolu hızla;"
    },
    {
      "type": "quote",
      "text": "Milyonları aşmış bütün evlâdlarınızla."
    },
    {
      "type": "quote",
      "text": "Birden açılır rûhuma esrârlı bir âlem;"
    },
    {
      "type": "quote",
      "text": "Vasfeyleyemez aşkımı, şiirimdeki nâlem…"
    },
    {
      "type": "paragraph",
      "parts": [
        {
          "text": "ALİ ULVÎ",
          "bold": true
        }
      ]
    }
  ]
}
